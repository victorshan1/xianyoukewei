# 复制本文件为 .env 并填写真实值（.env 已被 git ignore，不会入库）
# 加载方式：服务启动时自动读取项目根目录（backend/）下的 .env

# 服务端口（默认 3000）
PORT=3000

# 运行环境：development | production
NODE_ENV=development

# JWT 签名密钥（生产环境必须设置强随机值！）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 前端静态目录（默认 backend 上一级，即项目根目录）
# FRONTEND_DIR=/path/to/frontend

# 日志目录与保留天数（默认 backend/logs，保留 7 天）
# LOG_DIR=./logs
# LOG_KEEP_DAYS=7

# 认证接口限流（防暴力破解）：窗口毫秒 / 窗口内最大请求数
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=30